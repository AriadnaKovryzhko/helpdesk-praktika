{
  "name": "helpdesk-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint \"{src,test,prisma}/**/*.ts\"",
    "format": "prettier --write \"{src,test,prisma}/**/*.ts\"",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:int": "jest --config test/jest-int.json --runInBand",
    "seed": "prisma db seed",
    "migrate:deploy": "prisma migrate deploy"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@nestjs/common": "11.2.9",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.9",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.9",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/swagger": "11.4.8",
    "@nestjs/throttler": "6.7.1",
    "@prisma/client": "6.19.3",
    "argon2": "0.44.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "prisma": "6.19.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.9",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.5",
    "@types/supertest": "6.0.3",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.5.0",
    "jest": "29.7.0",
    "prettier": "3.9.10",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.service.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
